/*
  # Empêche l'affichage dans une iframe (clickjacking)
  X-Frame-Options: DENY

  # Empêche le browser de deviner le type MIME
  X-Content-Type-Options: nosniff

  # Contrôle les infos envoyées au site suivant
  Referrer-Policy: strict-origin-when-cross-origin

  # Force HTTPS pendant 1 an
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Désactive les fonctionnalités non utilisées
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://www.googletagmanager.com https://cdn-cgi.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; frame-ancestors 'none';
